{
  "name": "@quantovainc/qcore",
  "version": "0.1.30",
  "description": "Quantova's post quantum client core for JavaScript. Signs with ML-DSA-65 and builds Q1 addresses.",
  "scripts": {
    "build": "bash scripts/build.sh",
    "test": "node test-types.js && node test-conformance.js && node test-order-nonce.js && node test-chain-binding.js && node test-sign-validate.js && node test-transport.js && node test-fee-cap.js && node test-network.js"
  },
  "keywords": [
    "post-quantum",
    "quantum-resistant",
    "quantum-safe",
    "blockchain",
    "wallet",
    "sdk",
    "cryptography",
    "ml-dsa",
    "fips-204",
    "quantova"
  ],
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "node": {
        "types": "./index.d.ts",
        "require": "./index.js",
        "import": "./index.js",
        "default": "./index.js"
      },
      "browser": {
        "types": "./index.d.ts",
        "import": "./browser.mjs",
        "default": "./browser.mjs"
      },
      "import": {
        "types": "./index.d.ts",
        "default": "./browser.mjs"
      },
      "require": {
        "types": "./index.d.ts",
        "default": "./index.js"
      },
      "default": "./index.js"
    },
    "./pkg": "./pkg/qcore_js.js",
    "./pkg/*": "./pkg/*",
    "./pkg-node": "./pkg-node/qcore_js.js",
    "./pkg-node/*": "./pkg-node/*",
    "./package.json": "./package.json"
  },
  "license": "(Apache-2.0 OR MIT)",
  "author": "Quantova Inc",
  "homepage": "https://github.com/Quantova/QCore.js#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Quantova/QCore.js.git"
  },
  "bugs": {
    "url": "https://github.com/Quantova/QCore.js/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "index.js",
    "browser.mjs",
    "shared.js",
    "index.d.ts",
    "pkg-node/qcore_js.js",
    "pkg-node/qcore_js_bg.wasm",
    "pkg-node/qcore_js.d.ts",
    "pkg-node/package.json",
    "pkg/qcore_js.js",
    "pkg/qcore_js_bg.js",
    "pkg/qcore_js_bg.wasm",
    "pkg/qcore_js.d.ts",
    "pkg/qcore_js_bg.wasm.d.ts",
    "pkg/package.json",
    "README.md",
    "LICENSE-APACHE",
    "LICENSE-MIT"
  ],
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  }
}
